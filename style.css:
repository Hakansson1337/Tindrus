body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #05070d;
    color: white;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.app {
    width: 95%;
    max-width: 450px;
    height: 90vh;
    background: #101522;
    border-radius: 30px;
    padding: 20px;
    box-shadow: 0 0 30px rgba(255, 50, 80, 0.25);
    display: flex;
    flex-direction: column;
}

h1 {
    text-align: center;
    margin: 5px;
    font-size: 34px;
}

.subtitle {
    text-align: center;
    color: #aaa;
    margin-bottom: 20px;
}

#chat {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
}

.message {
    padding: 12px 16px;
    border-radius: 20px;
    margin: 10px 0;
    max-width: 80%;
}

.tindrus {
    background: #20283a;
    align-self: flex-start;
}

.user {
    background: #c92f5b;
    align-self: flex-end;
    margin-left: auto;
}

.input-area {
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    padding: 15px;
    border-radius: 25px;
    border: none;
    background: #222b3d;
    color: white;
    font-size: 16px;
}

button {
    border: none;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    background: #e83f6f;
    color: white;
    font-size: 20px;
}

.voice {
    width: 100%;
    border-radius: 25px;
    margin-top: 15px;
}
